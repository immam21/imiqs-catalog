# Service account (from the JSON key file)
GOOGLE_CLIENT_EMAIL=imiqs-sync@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Drive folder ID (last part of the folder URL) and Sheet ID (between /d/ and /edit)
DRIVE_FOLDER_ID=
SHEET_ID=
SHEET_RANGE=Products!A2:G

# WhatsApp number with country code, digits only
WHATSAPP_NUMBER=919999999999

# Any long random string. Protects /api/sync (Vercel cron sends it automatically)
CRON_SECRET=

# Added automatically when you create a Blob store in Vercel
BLOB_READ_WRITE_TOKEN=
